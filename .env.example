# ==============================================================================
# NBKRIST SMART DIGITAL NOTICE BOARD — PRODUCTION CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Netlify Deployment)
# ------------------------------------------------------------------------------
# URL of your separate deployed Express backend (no trailing slash)
VITE_BACKEND_URL=https://YOUR-BACKEND-DOMAIN

# Google reCAPTCHA v2 (Checkbox) Site Key (Client-Side)
VITE_RECAPTCHA_SITE_KEY=your_google_recaptcha_v2_site_key

# Firebase Client Configuration (Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Separate Express Production Server)
# ------------------------------------------------------------------------------
# Allowed Frontend Origin for CORS (e.g., your Netlify URL, no trailing slash)
FRONTEND_URL=https://YOUR-NETLIFY-DOMAIN.netlify.app

# Google reCAPTCHA v2 Secret Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
CAPTCHA_SECRET=your_google_recaptcha_v2_secret_key
# Alternatively:
# RECAPTCHA_SECRET_KEY=your_google_recaptcha_v2_secret_key

# Telegram Bot Token (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
BOT_TOKEN=your_telegram_bot_token_from_botfather
# Alternatively:
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Node Environment
NODE_ENV=production
